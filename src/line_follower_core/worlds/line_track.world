<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="line_track_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Track segments -->
    <!-- Front Straight -->
    <model name="track_front">
      <static>true</static>
      <link name="link">
        <pose>0.5 0 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.02 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Back Straight -->
    <model name="track_back">
      <static>true</static>
      <link name="link">
        <pose>0.5 1.0 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 0.02 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left Straight -->
    <model name="track_left">
      <static>true</static>
      <link name="link">
        <pose>0 0.5 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 1.0 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right Straight -->
    <model name="track_right">
      <static>true</static>
      <link name="link">
        <pose>1.0 0.5 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.02 1.0 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
